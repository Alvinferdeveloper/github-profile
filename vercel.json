{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/main.ts"
        }
    },
    "rewrites": [
        {
            "source": "/api/backend/(.*)",
            "destination": {
                "service": "backend",
                "path": "/$1"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}